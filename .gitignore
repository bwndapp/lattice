# data: users' tracks live here, never in git
data.db
data.db.before-*
data-draft.db
*.db-wal
*.db-shm
# build output and publish backups (rebuilt with npm run build / draft, bwnd-publish)
public/
public.bak/
webapp/
.bwnd/
src/api-live/
src/api-live.bak/
# python caches
__pycache__/

# save points: database snapshots and the live build at that moment
saves/

# worktrees: a branch checked out beside the repo is its own checkout, not content.
# Tracking it made every edit in a branch show up as a dirty file here, and put a stale
# duplicate of the whole app in this history.
.claude/
